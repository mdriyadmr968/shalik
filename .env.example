# ==============================================================================
# Shalik (শালিক) Environment Configuration
# ==============================================================================

# Google Gemini API Key for live AI responses (Optional, enables live LLM streaming)
# Get your free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Mode: 'auto' (uses Gemini if API key present, falls back to offline RAG)
VITE_AI_MODE=auto

# ==============================================================================
# Real Database Synchronization Configuration (Optional)
# If left empty, Shalik automatically uses local storage + simulated cloud sync
# ==============================================================================

# Option 1: Supabase (PostgreSQL with REST API)
# Get your project URL and anon key from: https://app.supabase.com/
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Option 2: Custom JSON REST API Sync Endpoint
VITE_SYNC_API_URL=
