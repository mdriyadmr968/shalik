# Google Gemini API Key for live AI responses (Optional, enables live LLM streaming)
# Get your free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Mode: 'auto' (uses Gemini if API key present, falls back to offline RAG)
VITE_AI_MODE=auto
